# ESP32-S3-WROOM-1-N16R8: 16 MB flash, 8 MB octal PSRAM (../main_pcb/spec.md)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# the console on UART0 (the TX/RX test pads) and, through main/usb_console.c, over USB:
# USB belongs to TinyUSB (MIDI and a CDC serial port), so ESP-IDF's own console stays on UART
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# USB-MIDI and the console's serial port (TinyUSB)
CONFIG_TINYUSB_MIDI_COUNT=1
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
# a crash's core dump into its flash partition (main/history.c)
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
